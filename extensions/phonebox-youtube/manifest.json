{
  "manifest_version": 3,
  "name": "PhoneBox YouTube",
  "description": "Show a YouTube tab on PhoneBox when you leave it. Sound stays on your PC.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Start / stop YouTube on PhoneBox" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*" }
}
